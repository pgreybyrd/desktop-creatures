<Window x:Class="Desktop_Creatures.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

    <Window.Resources>
        <Style x:Key="InvisibleImageButton"
       TargetType="Button">

            <Setter Property="Background"
            Value="Transparent"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Padding"
            Value="0"/>

            <Setter Property="Focusable"
            Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="SettingsCanvas"
            Width="171"
            Height="221">

        <Border
            Canvas.Top="30"
            Width="151"
            Height="36"
            Background="Transparent"
            MouseLeftButtonDown="DragArea_MouseLeftButtonDown" />

        <!-- Actual 147x189 settings panel -->
        <Image x:Name="SettingsBackgroundImage"
               Width="151"
               Height="191"
               Canvas.Left="0"
               Canvas.Top="30"
               Stretch="None"
               IsHitTestVisible="False" />

        <!-- X lives OUTSIDE the panel -->
        <Image x:Name="ExitImage"
               Canvas.Left="130"
               Canvas.Top="6"
               Stretch="None"
               MouseEnter="Exit_MouseEnter"
               MouseLeave="Exit_MouseLeave"
               MouseLeftButtonDown="Exit_MouseDown"
               MouseLeftButtonUp="Exit_MouseUp" />

        <!-- Buttons now get +8 Y because panel starts at Y=8 -->

        <Button Canvas.Left="19"
                Canvas.Top="109"
                Width="23"
                Height="23"
                Style="{StaticResource InvisibleImageButton}"
                Click="Scale1_Click"
                MouseEnter="Scale1_MouseEnter"
                MouseLeave="Scale1_MouseLeave"
                PreviewMouseLeftButtonDown="Scale1_MouseDown"
                PreviewMouseLeftButtonUp="Scale1_MouseUp">

            <Image x:Name="Scale1Image"
                   Width="23"
                   Height="23"
                   Stretch="None"
                   IsHitTestVisible="False"/>
        </Button>

        <Button Canvas.Left="49"
                Canvas.Top="109"
                Width="23"
                Height="23"
                Style="{StaticResource InvisibleImageButton}"
                Click="Scale2_Click"
                MouseEnter="Scale2_MouseEnter"
                MouseLeave="Scale2_MouseLeave"
                PreviewMouseLeftButtonDown="Scale2_MouseDown"
                PreviewMouseLeftButtonUp="Scale2_MouseUp">
            <Image x:Name="Scale2Image"
                   Width="23"
                   Height="23"
                   Stretch="None"
                   IsHitTestVisible="False"/>
        </Button>

        <Button Canvas.Left="79"
                Canvas.Top="109"
                Width="23"
                Height="23"
                Style="{StaticResource InvisibleImageButton}"
                Click="Scale3_Click"
                MouseEnter="Scale3_MouseEnter"
                MouseLeave="Scale3_MouseLeave"
                PreviewMouseLeftButtonDown="Scale3_MouseDown"
                PreviewMouseLeftButtonUp="Scale3_MouseUp">
            <Image x:Name="Scale3Image"
                   Width="23"
                   Height="23"
                   Stretch="None"
                   IsHitTestVisible="False"/>
        </Button>

        <Button Canvas.Left="108"
                Canvas.Top="109"
                Width="23"
                Height="23"
                Style="{StaticResource InvisibleImageButton}"
                Click="Scale4_Click"
                MouseEnter="Scale4_MouseEnter"
                MouseLeave="Scale4_MouseLeave"
                PreviewMouseLeftButtonDown="Scale4_MouseDown"
                PreviewMouseLeftButtonUp="Scale4_MouseUp">
            <Image x:Name="Scale4Image"
                   Width="23"
                   Height="23"
                   Stretch="None"
                   IsHitTestVisible="False"/>
        </Button>

        <Image x:Name="AlwaysOnTopImage"
               Canvas.Left="52"
               Canvas.Top="179"
               Stretch="None"
               MouseEnter="AlwaysOnTop_MouseEnter"
               MouseLeave="AlwaysOnTop_MouseLeave"
               MouseLeftButtonDown="AlwaysOnTop_MouseDown"
               MouseLeftButtonUp="AlwaysOnTop_MouseUp"/>

    </Canvas>
</Window>
<Window x:Class="Desktop_Creatures.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

    <Canvas x:Name="SettingsCanvas"
            Width="171"
            Height="221">

        <Border
            Canvas.Top="30"
            Width="151"
            Height="36"
            Background="Transparent"
            MouseLeftButtonDown="DragArea_MouseLeftButtonDown" />

        <!-- Actual 147x189 settings panel -->
        <Image Source="/Assets/UI/Settings/settings_window.png"
               Width="151"
               Height="191"
               Canvas.Left="0"
               Canvas.Top="30"
               Stretch="None"
               IsHitTestVisible="False" />

        <!-- X lives OUTSIDE the panel -->
        <Image x:Name="ExitImage"
               Source="/Assets/UI/Settings/Buttons/exit.png"
               Canvas.Left="126"
               Canvas.Top="3"
               Stretch="None"
               MouseEnter="Exit_MouseEnter"
               MouseLeave="Exit_MouseLeave"
               MouseLeftButtonDown="Exit_MouseDown"
               MouseLeftButtonUp="Exit_MouseUp" />

        <!-- Buttons now get +8 Y because panel starts at Y=8 -->

        <Image x:Name="Scale1Image"
               Source="/Assets/UI/Settings/Buttons/scale_1x.png"
               Canvas.Left="19"
               Canvas.Top="109"
               Stretch="None" />

        <Image x:Name="Scale2Image"
               Source="/Assets/UI/Settings/Buttons/scale_2x.png"
               Canvas.Left="49"
               Canvas.Top="109"
               Stretch="None" />

        <Image x:Name="Scale3Image"
               Source="/Assets/UI/Settings/Buttons/scale_3x.png"
               Canvas.Left="79"
               Canvas.Top="109"
               Stretch="None" />

        <Image x:Name="Scale4Image"
               Source="/Assets/UI/Settings/Buttons/scale_4x.png"
               Canvas.Left="108"
               Canvas.Top="109"
               Stretch="None" />

        <Image x:Name="AlwaysOnTopImage"
               Source="/Assets/UI/Settings/Buttons/toggle_off.png"
               Canvas.Left="52"
               Canvas.Top="179"
               Stretch="None" />

    </Canvas>
</Window>
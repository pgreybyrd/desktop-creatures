<Window x:Class="Desktop_Creatures.FieldGuideMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Desktop_Creatures.UI.Controls"
        
        Title="FieldGuideMenu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"

        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"

        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

    <Window.Resources>
        <Style x:Key="InvisibleTabButton"
           TargetType="Button">
            <Setter Property="Background"
                Value="Transparent"/>
            <Setter Property="BorderThickness"
                Value="0"/>
            <Setter Property="Padding"
                Value="0"/>
            <Setter Property="Focusable"
                Value="False"/>
            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Scaled as one giant pixel-art book -->
        <Canvas x:Name="BookCanvas"
            Width="201"
            Height="166">
            <!-- book, page turns, tabs, debug regions -->

            <Image x:Name="BookBaseImage"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Width="201"
                   Height="166"
                   Stretch="None"
                   IsHitTestVisible="False"/>

            <Canvas x:Name="CreatureEntryCanvas"
                    Width="201"
                    Height="166"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">

                <!-- LEFT PAGE -->

                <Border Canvas.Left="20"
                        Canvas.Top="37"
                        Width="78"
                        Height="12"
                        BorderBrush="Red"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">

                </Border>

                <!-- CREATURE PORTRAIT REGION -->

                <!-- Creature animation will eventually go here -->
                <Border Canvas.Left="28"
                        Canvas.Top="54"
                        Width="62"
                        Height="47"
                        BorderBrush="Cyan"
                        BorderThickness="1"
                        IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <Border Canvas.Left="34"
                        Canvas.Top="60"
                        Width="50"
                        Height="35"
                        BorderBrush="Blue"
                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Border Canvas.Left="20"
                        Canvas.Top="107"
                        Width="78"
                        Height="34"
                        BorderBrush="Green"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!-- RIGHT PAGE -->

                <Border Canvas.Left="104"
                        Canvas.Top="37"
                        Width="76"
                        Height="50"
                        BorderBrush="Orange"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <Border Canvas.Left="104"
                        Canvas.Top="92"
                        Width="76"
                        Height="30"
                        BorderBrush="Purple"
                        BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Border Canvas.Left="128"
                        Canvas.Top="128"
                        Width="28"
                        Height="13"
                        BorderBrush="Yellow"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            </Canvas>

            <Image x:Name="PageTurnImage"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Width="201"
                   Height="166"
                   Stretch="None"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

            <Border x:Name="BookDragArea"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="201"
                    Height="166"
                    Background="Transparent"
                    MouseLeftButtonDown="BookDragArea_MouseLeftButtonDown"/>

            <Image x:Name="RestingTabImage"
                   Canvas.Left="181"
                   Canvas.Top="40"
                   Width="7"
                   Height="8"
                   Stretch="None"
                   IsHitTestVisible="False"/>

            <Image x:Name="TurningTabImage"
                   Width="7"
                   Height="8"
                   Stretch="None"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderTransformOrigin="0.5,0.5"/>

            <Button x:Name="RightTabButton"
                    Style="{StaticResource InvisibleTabButton}"
                    Canvas.Left="181"
                    Canvas.Top="40"
                    Width="7"
                    Height="8"
                    Click="RightTabButton_Click"
                    MouseEnter="RightTabButton_MouseEnter"
                    MouseLeave="RightTabButton_MouseLeave"
                    PreviewMouseLeftButtonDown="RightTabButton_MouseDown"
                    PreviewMouseLeftButtonUp="RightTabButton_MouseUp"/>

            <Image x:Name="LeftRestingTabImage"
                   Canvas.Left="13"
                   Canvas.Top="40"
                   Width="7"
                   Height="8"
                   Stretch="None"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderTransformOrigin="0.5,0.5">

                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1"/>
                </Image.RenderTransform>
            </Image>

            <Button x:Name="SpawnCreatureButton"
                    Style="{StaticResource InvisibleTabButton}"
                    Visibility="Collapsed"
                    Canvas.Left="128"
                    Canvas.Top="128"
                    Width="28"
                    Height="13"
                    Click="SpawnCreature_Click"
                    MouseEnter="SpawnCreatureButton_MouseEnter"
                    MouseLeave="SpawnCreatureButton_MouseLeave"
                    PreviewMouseDown="SpawnCreatureButton_MouseLeftButtonDown"
                    PreviewMouseUp="SpawnCreatureButton_MouseUp" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Button x:Name="LeftTabButton"
                    Style="{StaticResource InvisibleTabButton}"
                    Canvas.Left="13"
                    Canvas.Top="40"
                    Width="7"
                    Height="8"
                    Visibility="Collapsed"
                    IsEnabled="False"
                    Click="LeftTabButton_Click"
                    MouseEnter="LeftTabButton_MouseEnter"
                    MouseLeave="LeftTabButton_MouseLeave"
                    PreviewMouseLeftButtonDown="LeftTabButton_MouseDown"
                    PreviewMouseLeftButtonUp="LeftTabButton_MouseUp"/>

        </Canvas>

        <!-- Actual screen-space content -->
        <Canvas x:Name="CreatureContentCanvas"
                Visibility="Collapsed"
                IsHitTestVisible="False">

            <controls:BitmapText
                x:Name="CreatureNameText"
                Text="{Binding Name}"/>

            <controls:BitmapText
                x:Name="CreatureFactsText"
                Text="{Binding FactsText}"
                LineSpacing="1"/>

            <controls:BitmapText
                x:Name="CreatureDescriptionText"
                Text="{Binding Description}"
                LineSpacing="1"/>

            <controls:BitmapText
                x:Name="CreatureFieldNotesText"
                Text="{Binding FieldNotesText}"
                LineSpacing="1"/>

            <Image x:Name="SpawnButtonImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   IsHitTestVisible="False"/>

        </Canvas>
    </Grid>
</Window>

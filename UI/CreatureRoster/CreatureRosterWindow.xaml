<Window x:Class="Desktop_Creatures.UI.CreatureRoster.CreatureRosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creature Roster"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">

    <Canvas x:Name="RosterCanvas"
            Width="118"
            Height="130">

        <Image x:Name="RosterBaseImage"
               Canvas.Left="0"
               Canvas.Top="0"
               Stretch="None"/>

        <!-- portrait goes here later -->
        <Image x:Name="PortraitImage"
               Canvas.Left="20"
               Canvas.Top="18"
               Width="59"
               Height="42"
               Stretch="Uniform"/>

        <TextBlock x:Name="NameText"
                   Canvas.Left="26"
                   Canvas.Top="64"
                   Width="51"
                   TextAlignment="Center"
                   FontSize="7"/>

        <TextBlock x:Name="SpeciesText"
                   Canvas.Left="26"
                   Canvas.Top="76"
                   Width="51"
                   TextAlignment="Center"
                   FontSize="5"/>

        <!-- Favorite -->
        <Image x:Name="FavoriteImage"
               Canvas.Left="83"
               Canvas.Top="17"
               Stretch="None"
               MouseLeftButtonDown="Favorite_MouseLeftButtonDown"/>

        <!-- Main Spawn / Put Away button -->
        <Image x:Name="ActionButtonImage"
               Canvas.Left="24"
               Canvas.Top="87"
               Stretch="None"
               MouseEnter="ActionButton_MouseEnter"
               MouseLeave="ActionButton_MouseLeave"
               MouseLeftButtonDown="ActionButton_MouseLeftButtonDown"
               MouseLeftButtonUp="ActionButton_MouseLeftButtonUp"/>

        <Image x:Name="ActionTextImage"
               Canvas.Left="24"
               Canvas.Top="87"
               IsHitTestVisible="False"
               Stretch="None"/>

        <!-- Rename -->
        <Image x:Name="RenameButtonImage"
               Canvas.Left="24"
               Canvas.Top="106"
               Stretch="None"
               MouseEnter="RenameButton_MouseEnter"
               MouseLeave="RenameButton_MouseLeave"
               MouseLeftButtonDown="RenameButton_MouseLeftButtonDown"
               MouseLeftButtonUp="RenameButton_MouseLeftButtonUp"/>

        <Image x:Name="RenameTextImage"
               Canvas.Left="24"
               Canvas.Top="106"
               IsHitTestVisible="False"
               Stretch="None"/>

        <!-- Scroll controls -->
        <Image x:Name="ArrowUpImage"
               Canvas.Left="94"
               Canvas.Top="17"
               Stretch="None"
               MouseEnter="ArrowUp_MouseEnter"
               MouseLeave="ArrowUp_MouseLeave"
               MouseLeftButtonDown="ArrowUp_MouseLeftButtonDown"
               MouseLeftButtonUp="ArrowUp_MouseLeftButtonUp"/>

        <Image x:Name="ArrowDownImage"
               Canvas.Left="94"
               Canvas.Top="111"
               Stretch="None"
               MouseEnter="ArrowDown_MouseEnter"
               MouseLeave="ArrowDown_MouseLeave"
               MouseLeftButtonDown="ArrowDown_MouseLeftButtonDown"
               MouseLeftButtonUp="ArrowDown_MouseLeftButtonUp"/>

        <!-- temporary scrollbar thumb; we'll make this truly proportional next -->
        <StackPanel x:Name="ScrollThumb"
                    Canvas.Left="96"
                    Canvas.Top="43">
            <Image x:Name="ScrollThumbTop"
                   Stretch="None"/>
            <Image x:Name="ScrollThumbMiddle"
                   Stretch="None"/>
            <Image x:Name="ScrollThumbBottom"
                   Stretch="None"/>
        </StackPanel>
    </Canvas>
</Window>
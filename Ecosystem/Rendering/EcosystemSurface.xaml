<Window x:Class="Desktop_Creatures.Ecosystem.Rendering.EcosystemSurface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">

    <Canvas x:Name="EcosystemCanvas"
            Background="Transparent">

        <!-- TEMPORARY:
             proves that the ecosystem surface is aligned
             with the monitor correctly. -->
        <Border Width="100"
                Height="100"
                Canvas.Left="50"
                Canvas.Top="50"
                BorderThickness="4"
                BorderBrush="Magenta"
                Background="#4000FFFF"
                IsHitTestVisible="False" />

    </Canvas>

</Window>